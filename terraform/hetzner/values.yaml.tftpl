# =============================================================================
# OMCSI Helm values for a single-node Hetzner cluster (rendered by Terraform)
# =============================================================================
# Uploaded to the server and applied with `helm upgrade --install`. Contains
# secrets, so it is written with 0600 permissions. Tuned for one self-managed
# node: services exposed via fixed NodePorts on the node's public IP, the
# local-path StorageClass for PVCs, and PodDisruptionBudgets disabled (a single
# node cannot satisfy minAvailable during drains).
# =============================================================================

minecraftWrapper:
  image:
    repository: ${image_registry}/open-mc-server
    # Pinned separately from the supporting images: this is the only image CI
    # publishes under a version tag, and it is the one whose baked Spigot jar
    # has to match MINECRAFT_VERSION below.
    tag: "${image_tag}"
  service:
    type: NodePort
    minecraftPort: 25565
    # Served directly on the node IP — requires the widened
    # service-node-port-range configured by cloud-init.
    nodePort: ${minecraft_nodeport}
  env:
    MINECRAFT_VERSION: "${minecraft_version}"
    OPERATOR_UUID: "${operator_uuid}"
    OPERATOR_NAME: "${operator_name}"
    SERVER_MOTD: "${server_motd}"
    MAX_PLAYERS: "${max_players}"
    # Only players in whitelist.json may join when WHITELIST_ENABLED is true.
    # ENFORCE_WHITELIST also kicks already-connected players who are not on the
    # list when it reloads.
    WHITELIST_ENABLED: "${whitelist_enabled}"
    ENFORCE_WHITELIST: "${enforce_whitelist}"
    DIFFICULTY: "${difficulty}"
    GAMEMODE: "${gamemode}"
    PVP_ENABLED: "${pvp_enabled}"
    ONLINE_MODE: "${online_mode}"
    JAVA_OPTS: "${java_opts}"
    # Comma-separated list of direct download URLs to plugin JARs, fetched on
    # server setup. Quoted so the URLs' ":" and "," survive as one YAML scalar;
    # var validation rejects embedded whitespace and double quotes.
    DEFAULT_PLUGINS: "${default_plugins}"
    # All four upload limits are derived from world_upload_max_size_mb so they
    # cannot drift apart; the smallest of them is what a client actually hits.
    MAX_FILE_UPLOAD_SIZE: "${world_upload_max_size_mb}MB"
    MAX_REQUEST_UPLOAD_SIZE: "${world_upload_max_size_mb}MB"
    MULTIPART_TEMP_DIR: "${multipart_temp_dir}"
    WORLD_UPLOAD_MAX_FILE_SIZE_MB: "${world_upload_max_size_mb}"
    WORLD_UPLOAD_MAX_EXTRACTED_MB: "${world_upload_max_extracted_mb}"
    WORLD_UPLOAD_MAX_ENTRIES: "${world_upload_max_entries}"

webapp:
  image:
    repository: ${image_registry}/open-mc-server-webapp
    tag: "${supporting_image_tag}"
  env:
    MAX_FILE_UPLOAD_SIZE: "${world_upload_max_size_mb}MB"
    MAX_REQUEST_UPLOAD_SIZE: "${world_upload_max_size_mb}MB"
    MULTIPART_TEMP_DIR: "${multipart_temp_dir}"
    WORLD_UPLOAD_READ_TIMEOUT_SECONDS: "${world_upload_timeout_seconds}"
    # Lets the dashboard link the map; empty unless BlueMap is enabled.
    BLUEMAP_URL: "${bluemap_url}"

nginx:
  image:
    repository: ${image_registry}/open-mc-server-nginx
    tag: "${supporting_image_tag}"
  service:
    type: NodePort
    httpNodePort: ${http_nodeport}
    httpsNodePort: ${https_nodeport}
  # Kept in step with the app-side multipart limits above. The chart's own
  # default is 100M, which silently caps uploads well below the 2048MB the
  # services advertise; deriving both from one variable removes that trap.
  maxBodySize: ${world_upload_max_size_mb}M
  bluemap:
    enabled: ${bluemap_enabled}
    path: "${bluemap_path}"
  uploadTimeout: ${world_upload_timeout_seconds}s

backupManager:
  image:
    repository: ${image_registry}/open-mc-server-backup-manager
    tag: "${supporting_image_tag}"
  env:
    BACKUP_MAX_SIZE_MB: "${backup_max_size_mb}"

alertManager:
  image:
    repository: ${image_registry}/open-mc-server-alert-manager
    tag: "${supporting_image_tag}"
  env:
    DISCORD_ENABLED: "${discord_enabled}"

agentManager:
  enabled: ${agent_manager_enabled}
  image:
    repository: ${image_registry}/open-mc-server-agent-manager
    tag: "${supporting_image_tag}"

# Single-node: a PodDisruptionBudget with minAvailable: 1 would block node
# drains, so disable PDBs here.
podDisruptionBudgets:
  enabled: false

persistence:
  mcserver:
    storageClass: "${storage_class}"
    size: ${mcserver_storage_size}
  webappData:
    storageClass: "${storage_class}"
  alertManagerData:
    storageClass: "${storage_class}"
  backups:
    storageClass: "${storage_class}"
    size: ${backups_storage_size}

# Namespace-scoped ServiceAccounts for operating this release, so routine work
# does not need the cluster-admin certificate Terraform wrote. Off unless asked
# for: enabling it creates credentials.
rbac:
  enabled: ${rbac_enabled}
  operator:
    enabled: ${rbac_operator_enabled}

secrets:
  rconPassword: "${rcon_password}"
  adminPassword: "${admin_password}"
  discordWebhookUrl: "${discord_webhook_url}"
  deployAuthToken: "${deploy_auth_token}"
  agentDiscordBotToken: "${agent_discord_bot_token}"
  agentDiscordChannelId: "${agent_discord_channel_id}"
  agentAnthropicApiKey: "${agent_anthropic_api_key}"
