# =============================================================================
# Example Terraform variables for OMCSI on a single Hetzner Cloud server
# =============================================================================
# Copy to terraform.tfvars and fill in the values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Or export the token and pass the rest via -var:
#   export TF_VAR_hcloud_token="your-hetzner-api-token"
#   terraform apply -var rcon_password=changeme -var admin_password=strongpass \
#     -var ssh_public_key="$(cat ~/.ssh/id_ed25519.pub)" \
#     -var ssh_private_key_path="$HOME/.ssh/id_ed25519"
# =============================================================================

# Hetzner Cloud API token (required) — Project → Security → API Tokens (Read & Write)
hcloud_token = "your-hetzner-api-token"

# SSH access (required) — Terraform bootstraps and deploys over SSH
ssh_public_key       = "ssh-ed25519 AAAA... you@host"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH + Kubernetes API to your own IP (strongly recommended).
# Game (25565) and web (80/443) stay public regardless.
# allowed_ssh_cidr = "203.0.113.4/32"

# Server sizing — cax31 (ARM, 16 GB) is the recommended default (~EUR 24.99/mo).
# cax21 (ARM, 8 GB, ~EUR 12.49/mo) fits a $20/mo budget; lower java_opts below.
# Prices as of 2026-09 — check Hetzner's current rates.
# server_type = "cax31"
# location    = "fsn1"

# OMCSI secrets (required)
rcon_password  = "changeme"
admin_password = "strongpassword"

# Server identity / gameplay
# operator_uuid = "your-minecraft-uuid"   # from https://mcuuid.net/
# operator_name = "YourMinecraftName"
# server_motd   = "An Open Minecraft Server"
# max_players   = 20
# difficulty    = "normal"      # peaceful | easy | normal | hard
# gamemode      = "survival"    # survival | creative | adventure | spectator
# pvp_enabled   = true
# online_mode   = true          # off lets anyone join under any username

# Whitelist — only players in whitelist.json may join. enforce_whitelist also
# kicks already-connected players who are not on the list when it reloads.
# whitelist_enabled = true
# enforce_whitelist = true

# JVM heap — defaults suit cax31's 16 GB. Lower for smaller types:
#   cax21 (8 GB):  java_opts = "-Xmx4G -Xms2G"
# java_opts = "-Xmx6G -Xms4G"

# Container image registry — defaults to "dmccoystephenson" (Docker Hub).
# The default images are multi-arch (amd64 + arm64), so they run on CAX (ARM).
# image_registry = "dmccoystephenson"

# Image tag for the Minecraft server image (open-mc-server) only. Defaults to
# "latest", which floats. The Spigot jar is compiled into the image at build
# time, so a moving "latest" also moves the Minecraft version; pin a published
# tag for a reproducible deployment, and keep it consistent with
# minecraft_version.
# image_tag = "26.2"

# Image tag for the five supporting images (webapp, nginx, backup-manager,
# alert-manager, agent-manager). Leave this at "latest": CI publishes those
# images under the "latest" tag ONLY, so a version tag here fails to pull.
# supporting_image_tag = "latest"

# Optional: plugins installed on server setup — a comma-separated list of
# direct download URLs to plugin JARs, no spaces. A plugin already present in
# the plugins directory (matched by filename) is left untouched.
# default_plugins = "https://example.com/PluginA.jar,https://example.com/PluginB.jar"

# Optional: Discord alerts (enables Discord automatically when set)
# discord_webhook_url = "https://discord.com/api/webhooks/..."

# Optional: plugin hot-deploy bearer token
# deploy_auth_token = "your-secret-token"

# Optional: agent-manager (Discord AI bot)
# agent_manager_enabled    = true
# agent_discord_bot_token  = "BOT_TOKEN"
# agent_discord_channel_id = "CHANNEL_ID"
# agent_anthropic_api_key  = "API_KEY"

# Optional: world upload limits.
# Every layer in front of the upload — nginx's client_max_body_size, both
# services' multipart limits, and the wrapper's own check — is derived from
# world_upload_max_size_mb, so this one number is the cap. Defaults to 2048.
#
# Accepting a 5 GB world archive:
# world_upload_max_size_mb      = 5120
# world_upload_max_extracted_mb = 30720    # worlds expand several times over
# world_upload_max_entries      = 100000   # entry-count cap (zip bomb protection)
# world_upload_timeout_seconds  = 7200     # transfer + extract + swap + restart
# multipart_temp_dir            = "/mcserver/tmp"
# mcserver_storage_size         = "80Gi"   # holds the old and new world at once
#
# Backups are sized off the world, not the archive. The newest backup is never
# deleted to satisfy the cap, so a cap below one backup's size means only ever
# holding that one. For a 20 GB world, room for two or three:
# backup_max_size_mb   = 61440
# backups_storage_size = "70Gi"
